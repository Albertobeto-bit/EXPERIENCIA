                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Expanded(
                        child: Stack(
                          clipBehavior: Clip.none,
                          children: [
                            Positioned.fill(
                              child: Image.asset(curso.$4, fit: BoxFit.cover),
                            ),
                            Positioned(
                              left: 8,
                              bottom: -3,
                              child: Container(
                                width: 35,
                                height: 35,
